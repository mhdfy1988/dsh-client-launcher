{
  "name": "dsh-client-launcher",
  "version": "0.1.3",
  "private": true,
  "description": "Independent Electron client launcher for DeepSeek Harness",
  "author": "mhdfy1988",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhdfy1988/dsh-client-launcher.git"
  },
  "bugs": {
    "url": "https://github.com/mhdfy1988/dsh-client-launcher/issues"
  },
  "homepage": "https://github.com/mhdfy1988/dsh-client-launcher#readme",
  "license": "MIT",
  "type": "module",
  "main": "lib/main.js",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test lib/tests/*.test.js",
    "start": "pnpm run build && electron lib/main.js",
    "versions": "node scripts/version-baseline.mjs",
    "smoke:lifecycle": "pnpm run build && node scripts/lifecycle-smoke.mjs",
    "smoke:recovery": "pnpm run build && node scripts/recovery-smoke.mjs",
    "smoke:window-state": "pnpm run build && node scripts/window-state-smoke.mjs",
    "smoke:single-instance": "pnpm run build && node scripts/single-instance-smoke.mjs",
    "package:portable": "pnpm run icons && pnpm run build && node scripts/package-portable.mjs",
    "package:installer": "node scripts/package-installer.mjs",
    "smoke:installer": "node scripts/installer-lifecycle-smoke.mjs",
    "smoke:portable": "pnpm run package:portable && node scripts/portable-smoke.mjs",
    "smoke:agent-toolchain": "pnpm run package:portable && node scripts/agent-toolchain-smoke.mjs",
    "smoke:directory-picker": "pnpm run build && electron scripts/directory-picker-electron-smoke.mjs",
    "smoke:titlebar-cdp": "node scripts/titlebar-cdp-smoke.mjs",
    "smoke:abi": "electron scripts/native-abi-electron.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cosmokit": "1.8.2",
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.1.1-rc.2",
    "@deepseek-ai/dsh-cmdline": "0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.1.1-rc.2",
    "@standard-schema/spec": "1.1.0",
    "electron-updater": "6.8.9",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "24.10.1",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "koffi": "3.1.6",
    "node-pty": "1.2.0-beta.15",
    "sharp": "0.35.3",
    "typescript": "6.0.3"
  }
}
